    "System Settings should be open. Under Allow in the Background, turn on both Sapphire and Sapphire Helper, then return here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置应该已经打开。请在“允许在后台运行”中启用 Sapphire 和 Sapphire Helper，然后返回这里。"
          }
        }
      }
    },
    "System apps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统应用"
          }
        }
      }
    },
    "TAP START TO BEGIN": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“开始”进入专注状态"
          }
        }
      }
    },
    "TIDAL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TIDAL"
          }
        }
      }
    },
    "TIDAL API Credentials": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TIDAL API 凭证"
          }
        }
      }
    },
    "Tap Install Helper. Approve the macOS prompt, then enable Sapphire under System Settings → General → Login Items → Background Activity.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“安装辅助服务”，同意 macOS 提示，然后在“系统设置”→“通用”→“登录项”→“后台活动”中启用 Sapphire。"
          }
        }
      }
    },
    "Tap the album art with two fingers to toggle playback.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两根手指点击专辑封面即可切换播放。"
          }
        }
      }
    },
    "Tap the pencil to create your first note.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击铅笔图标，创建第一条笔记。"
          }
        }
      }
    },
    "Target Charge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
