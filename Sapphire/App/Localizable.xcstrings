          }
        }
      }
    },
    "Timers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时器"
          }
        }
      }
    },
    "To control playback with a free account, please open the Spotify desktop app first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用免费账户控制播放前，请先打开 Spotify 桌面版。"
          }
        }
      }
    },
    "To enable Face ID or Bluetooth Unlock, you must first provide your Mac's login password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要启用面容 ID 或蓝牙解锁，您必须首先提供 Mac 的登录密码。"
          }
        }
      }
    },
    "To enable Spotify integration, please add your API credentials in Sapphire's settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要启用 Spotify 集成，请在 Sapphire 设置中添加 API 凭据。"
          }
        }
      }
    },
    "To improve Sapphire, we collect completely anonymous, aggregated usage data. This helps us understand which features are popular, identify bugs, and make the app better for everyone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了改进 Sapphire，我们会收集完全匿名的汇总使用数据，用于了解常用功能、发现问题并改善应用体验。"
          }
        }
      }
    },
    "To use Gemini Live, please add your Google AI Studio API key in Sapphire's settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用 Gemini Live，请在 Sapphire 设置中添加 Google AI Studio API 密钥。"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
