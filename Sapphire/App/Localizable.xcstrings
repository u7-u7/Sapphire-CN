            "state": "translated",
            "value": "曲目"
          }
        }
      }
    },
    "Track AI agents, builds, and terminal commands, and keep the Mac awake while they run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪 AI 智能体、构建和终端命令，并在任务运行时保持 Mac 唤醒。"
          }
        }
      }
    },
    "Trailing swipe on a clipboard row.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在剪贴板行上尾随滑动。"
          }
        }
      }
    },
    "Trailing swipe on a file drop row.": {
      "localizations": {
        "zh-Hans": {
