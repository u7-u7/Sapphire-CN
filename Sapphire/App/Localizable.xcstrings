{
  "sourceLanguage": "en",
  "strings": {
    "Third-party Usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方额度"
          }
        }
      }
    },
    "Use third-party usage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用第三方额度"
          }
        }
      }
    },
    "Configure a read-only balance endpoint for the current provider. Missing values and reset times remain unknown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前供应商配置只读额度查询接口。缺失数据和重置时间显示为未知。"
          }
        }
      }
    },
    "Platform name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台名称"
          }
        }
      }
    },
    "Current provider API address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前供应商 API 地址"
          }
        }
      }
    },
    "For CLI credentials, this address must match the active CLI provider. An unrelated API Key will not be sent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址须与当前 CLI 供应商一致，以免查到其他平台的额度。"
          }
        }
      }
    },
    "Usage template": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询模板"
          }
        }
      }
    },
    "Apply template": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用模板"
          }
        }
      }
    },
    "Usage query address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度查询地址"
          }
        }
      }
    },
    "Template fills the query address and JSON fields. Check your platform documentation before testing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板会填入查询地址及 JSON 字段。测试前请核对平台文档。"
          }
        }
      }
    },
    "Query credentials": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询凭据"
          }
        }
      }
    },
    "NewAPI User ID (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewAPI 用户 ID（可选）"
          }
        }
      }
    },
    "NewAPI requires an account Access Token and User ID, rather than a model API Key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewAPI 需要账户 Access Token 与用户 ID。"
          }
        }
      }
    },
    "Query Key or Access Token": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询 Key 或 Access Token"
          }
        }
      }
    },
    "Save query key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存查询密钥"
          }
        }
      }
    },
    "Remove saved key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除已保存密钥"
          }
        }
      }
    },
    "Query key saved in Keychain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询密钥已存入钥匙串"
          }
        }
      }
    },
    "Testing uses the entered key without saving it. Leave the field blank to use the saved query key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试使用输入的密钥，不自动保存。留空则使用此查询地址已保存的密钥。"
          }
        }
      }
    },
    "JSON fields and reset time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 字段与重置时间"
          }
        }
      }
    },
    "Use dotted JSON paths, including array indices: data.balance or balance_infos.0.total_balance. Empty fields stay unknown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用点号分隔 JSON 路径，数组序号也用点号，例如 data.balance 或 balance_infos.0.total_balance。空字段显示为未知。"
          }
        }
      }
    },
    "Remaining field": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余额度字段"
          }
        }
      }
    },
    "Used field (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用额度字段（可选）"
          }
        }
      }
    },
    "Total field (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总额度字段（可选）"
          }
        }
      }
    },
    "Currency field (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "货币字段（可选）"
          }
        }
      }
    },
    "Fallback unit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认单位"
          }
        }
      }
    },
    "Divide raw value by": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始数值除以"
          }
        }
      }
    },
    "NewAPI starts at 500000 quota per USD. Adjust this divisor to match your platform's conversion rule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NewAPI 模板默认每美元对应 500000 quota，请按平台实际换算规则调整除数。"
          }
        }
      }
    },
    "Reset field (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置时间字段（可选）"
          }
        }
      }
    },
    "Reset format": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置时间格式"
          }
        }
      }
    },
    "Test usage query": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试额度查询"
          }
        }
      }
    },
    "Testing only sends a GET balance request. It shares the widget's refresh interval and rate-limit cooldown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试仅发送只读 GET 额度请求，与组件共享刷新间隔及限流冷却。"
          }
        }
      }
    },
    "Remaining": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余"
          }
